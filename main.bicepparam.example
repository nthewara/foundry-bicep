// =============================================================================
// main.bicepparam.example
// Copy to main.bicepparam (gitignored) beside main.bicep and fill in.
// If storing elsewhere, update the relative `using` path as well.
//
// Deploy:
//   az deployment sub create \
//     --location australiaeast \
//     --template-file main.bicep \
//     --parameters main.bicepparam
// =============================================================================

using './main.bicep'

// ----- General -----
param location = 'australiaeast'
param prefix = 'aifoundrybicep'
// Leave blank to auto-derive from the subscription + RG name. Set explicitly
// if you want predictable names across re-deploys.
param randomSuffix = ''
// resourceGroupName defaults to '<prefix>-<suffix>'. Override if you have a
// naming convention.
// param resourceGroupName = 'rg-foundrybicep-lab'

param tags = {
  lab: 'foundry-bicep'
  managedBy: 'bicep'
  owner: 'nthewara'
  costCenter: 'lab'
  SecurityControl: 'Ignore'
}

// ----- Networking -----
param hubVnetPrefix = '10.100.0.0/23'
param vmVnetPrefix = '10.10.10.0/23'
param aiappVnetPrefix = '10.10.20.0/23'

// ----- Toggles -----
param fwProvision = true
param fwSku = 'Basic'
param bastionProvision = true
param vmDeploy = true
// Optional Azure Container Registry (Premium SKU) with private endpoint + AcrPull
// for the project identity.
param enableContainerRegistry = true
// Set to a developer IP CIDR (e.g. '203.0.113.0/26') to allow image push from
// that range; leave empty to keep ACR private-endpoint-only (public access off).
param developerIpCidr = ''
// Default-enabled tracing shares the existing diagnostics LAW. Ingestion is
// private; authorized public queries remain enabled for evaluations/portal.
param enableAgentTracing = true
// Default-enabled private-CA vault. Does NOT upload certificates or register trust.
// This is separate from the pre-existing vault used for adminPassword below.
param enableKeyVault = true
param keyVaultName = ''
// Same-tenant RBAC vault. Leave empty to create one. Existing configuration is
// not modified; a private endpoint and account-MI Secrets User are still added.
param existingKeyVaultResourceId = ''
// Example: '/subscriptions/<subscription-guid>/resourceGroups/<vault-rg>/providers/Microsoft.KeyVault/vaults/<vault-name>'

// ----- VM -----
param vmSize = 'Standard_D8s_v5'
param adminUsername = 'azureadmin'

// Wire the password from your existing Key Vault.
// Update the KV resource ID below to match your environment.
param adminPassword = az.getSecret(
  /* subscriptionId */ '<subscription-guid>',
  /* resourceGroup  */ '<existing-secret-vault-rg>',
  /* keyVaultName   */ '<existing-secret-vault-name>',
  /* secretName     */ 'foundrybicep-admin-password'
)

// ----- DNS -----
// Required zones are merged with this array, including zones for enabled
// features. Defaults produce 12 unique zones; the AMPLS PE maps FIVE zones,
// reusing the existing Blob zone rather than creating a duplicate.
// Override here to add extra zones; [] cannot remove required zones.
// param privateDnsZones = [ ... ]

// ----- Foundry / model -----
param aiServicesNameBase = 'aiservices'
param aiSearchNameBase = 'aisearch'
param cosmosDBNameBase = 'cosmosdb'
param azureStorageNameBase = 'foundrystg'

param projectName = 'project'
param projectDescription = 'A project for the AI Foundry account with network secured deployed Agent'
param projectDisplayName = 'network secured agent project'
param projectCapHostName = 'caphostproj'

param modelName = 'gpt-4o-mini'
param modelFormat = 'OpenAI'
param modelVersion = '2024-07-18'
param modelSkuName = 'GlobalStandard'
param modelCapacity = 30
